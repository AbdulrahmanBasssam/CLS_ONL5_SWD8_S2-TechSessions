{
  "name": "location",
  "version": "8.0.1",
  "summary": "Cross-platform plugin for easy access to the device location in real time.",
  "description": "Cross-platform plugin for easy access to the device location in real time.",
  "homepage": "https://github.com/Lyokone/flutterlocation",
  "license": {
    "file": "../LICENSE"
  },
  "authors": {
    "Lyokone": "https://github.com/Lyokone/flutterlocation"
